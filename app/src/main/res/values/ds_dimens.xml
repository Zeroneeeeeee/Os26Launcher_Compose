<!-- DS3 Task 1: quy ước khoảng cách và bố cục cho mọi màn v3 (docs/plans/DS3-design-system-v3.md mục "Quy ước khoảng cách").
     Khoảng cách GIỮA các khối chỉ lấy từ thang ds_space_*. Kích thước nội bộ của thành phần thêm ở Task 2-7, cuối file này. -->
<resources>
    <!-- Thang khoảng cách bố cục (lưới 8 dp, thêm bước 4, 12, 20) -->
    <dimen name="ds_space_4">4dp</dimen>
    <dimen name="ds_space_8">8dp</dimen>
    <dimen name="ds_space_12">12dp</dimen>
    <dimen name="ds_space_16">16dp</dimen>
    <dimen name="ds_space_20">20dp</dimen>
    <dimen name="ds_space_24">24dp</dimen>

    <!-- Màn hình -->
    <dimen name="ds_screen_margin_h">16dp</dimen>
    <dimen name="ds_screen_content_top">8dp</dimen>
    <dimen name="ds_screen_content_bottom">32dp</dimen>
    <dimen name="ds_section_header_gap">12dp</dimen>

    <!-- Bo góc: card, card nổi bật, sheet là BÁN KÍNH GỐC, bán kính thật = gốc nhân theo thanh "Bo góc" của kính (GT,
         GlassTuning.cornerRadius). Ô icon (tile) cố định tới khi có cơ chế bo góc icon (IS). Thành phần không đọc thẳng 4 dimen
         này mà hỏi qua DsCorner/DsCorners (quyết định 7 của plan DS3). -->
    <dimen name="ds_radius_card">20dp</dimen>
    <dimen name="ds_radius_card_large">24dp</dimen>
    <dimen name="ds_radius_sheet">28dp</dimen>
