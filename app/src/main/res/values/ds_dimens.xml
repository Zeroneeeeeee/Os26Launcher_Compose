    <dimen name="ds_tile_size">32dp</dimen>
    <dimen name="ds_icon_size">24dp</dimen>
    <dimen name="ds_touch_min">48dp</dimen>

    <!-- Khung footer nút cố định đáy màn: đệm 16/16/28/16, khe 8 -->
