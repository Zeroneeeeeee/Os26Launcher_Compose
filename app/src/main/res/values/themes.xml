<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Os26Launcher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Os26Launcher" parent="Base.Theme.Os26Launcher" />

    <!-- OB 0.0: theme khởi động của HomeActivity (manifest). API 26–30: cửa sổ khởi động vẽ nền splash; API 31+: xem values-v31.
         HomeActivity gọi setTheme(Theme.Os26Launcher) trước super.onCreate nên nền thật của Home không đổi. -->
    <style name="Theme.Os26Launcher.Starting" parent="Theme.Os26Launcher">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <!-- Thanh hệ thống cùng màu nền splash (không để màu mặc định của theme), icon thanh màu sáng. -->
        <item name="android:statusBarColor">@color/ds_bg_base</item>
        <item name="android:navigationBarColor">@color/ds_bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>