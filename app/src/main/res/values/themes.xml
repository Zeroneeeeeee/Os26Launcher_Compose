<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Os26Launcher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Os26Launcher" parent="Base.Theme.Os26Launcher" />

    <!-- OB 0.0: splash khởi động của LauncherEntryActivity (manifest), dùng androidx.core:core-splashscreen nên API 26+ cùng một kiểu:
         nền ds_bg_base + logo app (adaptive icon @mipmap/logo, hệ thống/thư viện cắt theo hình icon). LauncherEntryActivity gọi
         installSplashScreen() trước super.onCreate; xong splash, thư viện đổi sang postSplashScreenTheme. -->
    <style name="Base.Theme.Os26Launcher.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ds_bg_base</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Os26Launcher</item>
        <!-- Thanh hệ thống cùng màu nền splash, icon thanh màu sáng. -->
        <item name="android:statusBarColor">@color/ds_bg_base</item>
        <item name="android:navigationBarColor">@color/ds_bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Os26Launcher.Starting" parent="Base.Theme.Os26Launcher.Starting" />
</resources>
