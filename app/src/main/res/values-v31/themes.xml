<?xml version="1.0" encoding="utf-8"?>
<!-- OB 0.0: API 31+ luôn có splash của hệ thống; đặt màu nền ds_bg_base và logo Figma 302:3676. Ảnh v31 có quầng sáng nhỏ hơn
     (tắt hẳn trước mép vòng tròn 192 dp mà hệ thống cắt icon), xem plan OB nhật ký. -->
<resources>
    <style name="Theme.Os26Launcher.Starting" parent="Theme.Os26Launcher">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/ds_bg_base</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_v31</item>
        <item name="android:statusBarColor">@color/ds_bg_base</item>
        <item name="android:navigationBarColor">@color/ds_bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
